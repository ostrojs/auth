{
    "name": "@ostro/auth",
    "version": "2.0.0-alpha.6",
    "description": "Authentication module for OstroJS",
    "main": "authManager.js",
    "types": "types/authManager.d.ts",
    "exports": {
        ".": {
            "types": "./types/authManager.d.ts",
            "default": "./authManager.js"
        },
        "./*": {
            "types": "./types/*.d.ts",
            "default": "./*.js"
        }
    },
    "scripts": {
        "build": "npm run lint:check && npx tsc -p tsconfig.build.json && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "test": "npx c8 npx jest",
        "clean": "rm -rf build coverage",
        "lint:check": "tsc --noEmit -p tsconfig.build.json"
    },
    "dependencies": {
        "@ostro/contracts": "^2.0.0-alpha.6",
        "@ostro/support": "^2.0.0-alpha.7",
        "uid-safe": "^2.1.5"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "auth",
        "authentication",
        "api authentication",
        "authentication guard",
        "session authentication"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/auth.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/auth/issues"
    },
    "homepage": "https://github.com/ostrojs/auth#readme",
    "devDependencies": {
        "typescript": "^5.8.0",
        "@types/node": "^22.0.0",
        "@types/jest": "^30.0.0",
        "c8": "^10.1.3",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "@ostro/builder": "^2.0.0-alpha.4"
    },
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}
